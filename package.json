{
  "name": "cadence",
  "version": "0.2.0",
  "description": "Ritmo para o dia de trabalho: ciclo de foco e lembrete de movimento, na bandeja do Windows.",
  "main": "./out/main/index.js",
  "author": "VPixel",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "dist": "npm run build && electron-builder --win",
    "dist:msix": "npm run build && electron-builder --win appx",
    "release": "node scripts/app-id.mjs && npm run build && electron-builder --win -c.forceCodeSigning=true",
    "test": "tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.11",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.40.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.20.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "homepage": "https://vpixel.com.br"
}
